# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used exclusively inside app/api/** route handlers to perform
# the geofence-validated, authoritative punch in/out writes. Never expose
# this to the client or commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only needed to run `npm run migrate` (applies db/*.sql). Get these from
# Supabase's "Connect" dialog -> Session pooler tab, plus the DB password
# you set when creating the project. Not read by the app itself.
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_DB_POOLER_HOST=aws-0-your-region.pooler.supabase.com
SUPABASE_DB_POOLER_USER=postgres.your-project-ref
